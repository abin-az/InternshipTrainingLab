# OmniRoute Local Environment Configuration
# Default Gateway Port: 20128
PORT=20128
OMNIROUTE_PORT=20128
OMNIROUTE_SERVER_HOST=0.0.0.0

# Security (set REQUIRE_API_KEY=true if deploying publicly)
REQUIRE_API_KEY=false

# Auto-Combo and Fallback
DEFAULT_MODEL=auto
ROUTING_STRATEGY=auto

# Optional Provider API Keys (Uncomment and set if you have custom keys)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=AIzaSy...
# GROQ_API_KEY=gsk_...
# DEEPSEEK_API_KEY=sk-...
# MISTRAL_API_KEY=...
# OPENROUTER_API_KEY=sk-or-...
